# Copy to .env (docker compose reads it) or set in your host's dashboard.
PORT=8050
WEB_WORKERS=2
# Seconds browsers/CDNs may cache API responses (data only changes when you refresh).
NBA_API_CACHE_SECONDS=600
# Where the website reads its database. The image sets these; override for bare-metal installs.
# NBA_DB_PATH=/data/nba_serve.db
# NBA_READONLY=1
